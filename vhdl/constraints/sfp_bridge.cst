// SFP-xSPI Bridge - physical constraints
// Device: GW1N-UV9QN48C6/I5 (GW1N-9C), all banks VCCIO = 3.3 V
// Pin assignment and verified alternatives: doc/sfp-xspi-bridge-plan.md, section 3
//
// Dedicated pins (not assigned here): 3 JTAGSEL_N, 4 TMS, 5 TCK, 6 TDI, 7 TDO,
// 8 RECONFIG_N, 9 DONE, 48 MODE2/MODE1 (pull-down -> AUTOBOOT).
// Spare I/O: 10, 27, 28, 29, 30, 44, 45.

// ---- SFP high-speed (LVDS 100 Mbaud) ----------------------------------------
// TD: true LVDS output pair IOR11 (bank 1). Alternatives: 28,27 | 30,29 | 11,10.
IO_LOC  "sfp_td_p"     34,33;
IO_PORT "sfp_td_p"     IO_TYPE=LVDS25 DRIVE=3.5;

// RD: IOT32 (bank 0). External 2 x 49.9 R termination to Vbias is the default.
// Internal 100 R (DIFF_RESISTOR=ON) is a fallback with the external resistors
// not fitted - never both. DIFF_RESISTOR is accepted only in bank 0; remove the
// attribute entirely when RD is moved to another bank.
// Alternatives: 45,44 (bank 0) | 39,38 | 41,40 | 28,27 | 30,29 (external only).
IO_LOC  "sfp_rd_p"     43,42;
IO_PORT "sfp_rd_p"     IO_TYPE=LVDS25 DIFF_RESISTOR=OFF;

// ---- Clocks -----------------------------------------------------------------
// CLK_25M: dedicated right PLL input (RPLL_T_in). Fallback: 30 (GCLKT_3) or
// 10 (GCLKT_6) through the global network, with higher PLL input jitter.
IO_LOC  "clk_25m"      35;
IO_PORT "clk_25m"      IO_TYPE=LVCMOS33;

// ---- Host xSPI (bank 2, bottom edge) ----------------------------------------
// SCLK must stay on a GCLKT pin: 19 (GCLKT_4). Alternatives: 30 (GCLKT_3),
// 10 (GCLKT_6). Data, CS_N, DQS and IRQ may be permuted freely within 13-24.
IO_LOC  "host_irq_n"   13;
IO_PORT "host_irq_n"   IO_TYPE=LVCMOS33;
IO_LOC  "xspi_cs_n"    14;
IO_PORT "xspi_cs_n"    IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "xspi_io[0]"   15;
IO_PORT "xspi_io[0]"   IO_TYPE=LVCMOS33;
IO_LOC  "xspi_io[1]"   16;
IO_PORT "xspi_io[1]"   IO_TYPE=LVCMOS33;
IO_LOC  "xspi_io[2]"   17;
IO_PORT "xspi_io[2]"   IO_TYPE=LVCMOS33;
IO_LOC  "xspi_io[3]"   18;
IO_PORT "xspi_io[3]"   IO_TYPE=LVCMOS33;
IO_LOC  "xspi_sclk"    19;
IO_PORT "xspi_sclk"    IO_TYPE=LVCMOS33;
IO_LOC  "xspi_dqs"     20;
IO_PORT "xspi_dqs"     IO_TYPE=LVCMOS33;
IO_LOC  "xspi_io[4]"   21;
IO_PORT "xspi_io[4]"   IO_TYPE=LVCMOS33;
IO_LOC  "xspi_io[5]"   22;
IO_PORT "xspi_io[5]"   IO_TYPE=LVCMOS33;
IO_LOC  "xspi_io[6]"   23;
IO_PORT "xspi_io[6]"   IO_TYPE=LVCMOS33;
IO_LOC  "xspi_io[7]"   24;
IO_PORT "xspi_io[7]"   IO_TYPE=LVCMOS33;
IO_LOC  "host_rst_n"   11;
IO_PORT "host_rst_n"   IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---- SFP management (low speed, any free GPIO) -------------------------------
// TX_FAULT, LOS, MOD_ABS: open-collector/grounded in module; board rev A has no
// external pull-ups (INF-8074i asks for 4.7-10k), internal pull-ups enabled instead.
IO_LOC  "sfp_tx_dis"   38;
IO_PORT "sfp_tx_dis"   IO_TYPE=LVCMOS33;
IO_LOC  "sfp_tx_fault" 39;
IO_PORT "sfp_tx_fault" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "sfp_los"      40;
IO_PORT "sfp_los"      IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "sfp_mod_abs"  41;
IO_PORT "sfp_mod_abs"  IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "sfp_scl"      46;
IO_PORT "sfp_scl"      IO_TYPE=LVCMOS33 OPEN_DRAIN=ON;
IO_LOC  "sfp_sda"      47;
IO_PORT "sfp_sda"      IO_TYPE=LVCMOS33 OPEN_DRAIN=ON;

// ---- LEDs (any free GPIO) -----------------------------------------------------
// Active low: 3V3 -> 1k -> LED -> pin. Drive 0 to light.
IO_LOC  "led_link"     31;
IO_PORT "led_link"     IO_TYPE=LVCMOS33;
IO_LOC  "led_act"      32;
IO_PORT "led_act"      IO_TYPE=LVCMOS33;
